# Native TIFF storage, with ImageWalker's codec set and the one shared zlib.
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/../.dd/dependencies.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/zlib.cmake")
if(NOT TARGET ZLIB::ZLIB)
    add_library(ZLIB::ZLIB ALIAS libfiles-zlib)
endif()
if(TARGET libfiles-jpeg AND NOT TARGET JPEG::JPEG)
    add_library(JPEG::JPEG ALIAS libfiles-jpeg)
endif()
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/tiff")
set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
set(CMAKE_POLICY_DEFAULT_CMP0091 NEW)
set(BUILD_SHARED_LIBS OFF)
set(tiff-tools OFF)
set(tiff-tests OFF)
set(tiff-contrib OFF)
set(tiff-docs OFF)
set(tiff-install OFF)
set(tiff-deprecated OFF)
set(cxx OFF)
foreach(codec IN ITEMS jpeg old-jpeg webp zstd lzma jbig lerc libdeflate)
    set(${codec} OFF)
endforeach()
dd_dependency_arguments("${CMAKE_CURRENT_LIST_DIR}/dd-dependencies.json" libtiff _lf_tiff_acquisition)
FetchContent_Declare(libtiff ${_lf_tiff_acquisition} SYSTEM EXCLUDE_FROM_ALL)
FetchContent_MakeAvailable(libtiff)
add_library(libfiles-tiff INTERFACE)
add_library(libfiles::tiff ALIAS libfiles-tiff)
target_link_libraries(libfiles-tiff INTERFACE tiff)
